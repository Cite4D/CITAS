  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "build:docs": "tsc && vite build && node -e \"const fs=require('fs'); fs.rmSync('docs', {recursive:true, force:true}); fs.cpSync('dist', 'docs', {recursive:true}); fs.writeFileSync('docs/.nojekyll', ''); console.log('✓ Synced dist to docs/ with .nojekyll');\"",
    "preview": "vite preview --host 0.0.0.0 --port 4173"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
